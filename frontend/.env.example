# Vite settings. These values are public in the browser bundle.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_DATA=false
VITE_DEFAULT_LANGUAGE=en

# Required for Supabase sign-in, registration, recovery, and password reset.
# These values are public in the browser bundle; never use a service-role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
