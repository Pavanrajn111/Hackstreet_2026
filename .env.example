# Safe local-development template only. Copy app-specific values to
# backend/.env or frontend/.env; never put production secrets in this file.
APP_ENV=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./irrigation.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional weather overrides
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_API_TIMEOUT_SECONDS=8.0

# Frontend values are public when embedded in a build.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_DATA=false
VITE_DEFAULT_LANGUAGE=en

# ML remains disabled unless a complete compatible bundle is supplied.
ML_MODEL_ENABLED=false
ML_MODEL_DIR=ml/models/models
