# ==============================================================================
# AGR002 Smart Irrigation - Global Environment Configuration Example
# ==============================================================================
# Copy this file to .env for local overrides, or check frontend/.env.example
# and backend/.env.example for app-specific settings.

# Backend Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./irrigation.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_DATA=true
VITE_DEFAULT_LANGUAGE=en

# ML Model Configuration (Optional placeholder)
ML_MODEL_ENABLED=false
ML_MODEL_PATH=ml/models/irrigation_model.pkl
