# FastAPI Backend Environment Variables
APP_ENV=development
APP_NAME="AGR002 Smart Irrigation API"
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS settings (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./irrigation.db

# Weather service settings
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_API_TIMEOUT_SECONDS=8.0

# Machine Learning integration
ML_MODEL_ENABLED=true
ML_CROP_PLANNER_DIR=../ml/crop_planner
