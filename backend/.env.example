# FastAPI backend settings. Copy to .env for local development only.
APP_ENV=development
APP_NAME="AGR002 Smart Irrigation API"
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Comma-separated frontend origins; set the exact Vercel URL in Render.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Local SQLite default. On Render, set DATABASE_URL to
# sqlite:////var/data/irrigation.db and attach a persistent disk at /var/data.
DATABASE_URL=sqlite:///./irrigation.db

# Open-Meteo settings
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_TTL_SECONDS=3600
WEATHER_API_TIMEOUT_SECONDS=8.0

# ML remains disabled unless the complete, compatible bundle is supplied.
ML_MODEL_ENABLED=false
ML_MODEL_DIR=ml/models/models

# Optional. Supply a real key only in the deployment dashboard.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_TIMEOUT_SECONDS=25.0
GEMINI_MAX_OUTPUT_TOKENS=2400
