# FastAPI Backend Environment Variables
APP_ENV=development
APP_NAME="AGR002 Smart Irrigation API"
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS settings (comma-separated list of origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database
DATABASE_URL=sqlite:///./irrigation.db

# Machine Learning integration flag
ML_MODEL_ENABLED=false
ML_MODEL_PATH=../ml/models/irrigation_model.joblib
